{"is_source_file": true, "format": "Python (FastAPI / SQLAlchemy / Pydantic)", "description": "This file defines ORM models using SQLAlchemy for a customer management and billing system, along with corresponding Pydantic models for API data validation and serialization. It includes entities such as Customer, Product, Invoice, InvoiceItem, Payment, Reminder, and Analytics, with associated enums and relationships, and some API schema models.", "external_files": ["src.api.database"], "external_methods": [], "published": ["CustomerBase", "CustomerCreate", "CustomerOut", "ProductBase", "ProductCreate", "ProductOut", "InvoiceItemBase", "InvoiceItemCreate", "InvoiceItemOut", "InvoiceBase", "InvoiceCreate", "InvoiceOut", "PaymentBase", "PaymentCreate", "PaymentOut", "ReminderBase", "ReminderCreate", "ReminderOut", "AnalyticsBase", "AnalyticsCreate", "AnalyticsOut"], "classes": [{"name": "PaymentModeEnum", "description": "Enumeration of different payment modes such as cash, card, bank transfer, cheque, UPI, and other."}, {"name": "ReminderStatusEnum", "description": "Enumeration of reminder statuses including pending, sent, and failed."}, {"name": "Customer", "description": "Represents a customer with details like name, contact info, address, GSTIN, timestamps, active status, and relationships to invoices."}, {"name": "Product", "description": "Represents a product with attributes like name, description, HSN/SAC code, price, active status, and relationships to invoice items."}, {"name": "Invoice", "description": "Represents an invoice with invoice number, customer, dates, total amount, status, timestamps, and relationships to customer, invoice items, payments, and reminders."}, {"name": "InvoiceItem", "description": "Represents an item in an invoice linking product, quantity, rate, amount, and related to invoice and product."}, {"name": "Payment", "description": "Represents a payment record linked to an invoice with payment date, amount, mode, and reference."}, {"name": "Reminder", "description": "Represents a reminder sent for an invoice with status, delivery channel, and timestamp."}, {"name": "Analytics", "description": "Stores simple aggregation or statistical data points with metric name, value, and collected date."}], "methods": [{"name": "orm_mode", "description": "Config option in Pydantic models enabling ORM mode for model serialization."}], "calls": ["relationship", "Column", "ForeignKey", "func.now()", "enum.Enum", "BaseModel", "Field"], "search-terms": ["Customer", "Invoice", "InvoiceItem", "Payment", "Reminder", "Analytics", "payment_modes", "reminder_statuses", "InvoiceNumber", "invoice_date", "customer_id", "product_id"], "state": 2, "file_id": 12, "knowledge_revision": 25, "git_revision": "a4e90c6d46e851a257bc2e835e0db42e2a503773", "ctags": [{"_type": "tag", "name": "Analytics", "path": "/home/kavia/workspace/code-generation/customer-management-and-billing-system-119668/backend_fastapi/src/api/models.py", "pattern": "/^class Analytics(Base):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "AnalyticsBase", "path": "/home/kavia/workspace/code-generation/customer-management-and-billing-system-119668/backend_fastapi/src/api/models.py", "pattern": "/^class AnalyticsBase(BaseModel):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "AnalyticsCreate", "path": "/home/kavia/workspace/code-generation/customer-management-and-billing-system-119668/backend_fastapi/src/api/models.py", "pattern": "/^class AnalyticsCreate(AnalyticsBase):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "AnalyticsOut", "path": "/home/kavia/workspace/code-generation/customer-management-and-billing-system-119668/backend_fastapi/src/api/models.py", "pattern": "/^class AnalyticsOut(AnalyticsBase):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "Config", "path": "/home/kavia/workspace/code-generation/customer-management-and-billing-system-119668/backend_fastapi/src/api/models.p